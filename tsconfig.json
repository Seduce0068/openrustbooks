{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@wdio/globals"
    ],
    "outDir": "e2e-dist",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "e2e/**/*.ts"
  ]
}
